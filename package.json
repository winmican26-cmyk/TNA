{
  "name": "trust-no-agent", "version": "0.1.0", "private": true, "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=24.0.0"},
  "scripts": {
    "build": "tsc -p tsconfig.json", "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tests scripts eslint.config.js", "test": "npm run build && node --test dist/tests/**/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/apps/tna-gate-api/src/main.js",
    "demo": "npm run build && node dist/scripts/demo.js"
  },
  "dependencies": {"zod": "4.1.5"},
  "devDependencies": {"typescript": "5.9.2", "@types/node": "24.3.1", "eslint": "9.35.0", "typescript-eslint": "8.42.0", "@eslint/js": "9.35.0"}
}
