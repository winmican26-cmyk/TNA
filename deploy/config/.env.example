# TNA Deployment Engineering v0.1 — environment variable reference (section 117).
#
# This file documents every variable `apps/tna-platform`'s config loader
# (`packages/deployment-schema`) understands. It is NEVER populated with real secret values — copy it,
# fill in real values in your own untracked `.env`, or (in production) prefer the `*_FILE` variants
# pointing at a securely mounted secret file (see `compose.production.yaml`, which uses Docker secrets
# instead of literal environment values entirely).

# --- Required: environment mode ---
# One of: development | test | production. Production enables every strict check in section 15-17 —
# missing/weak secrets, an insecure CORS wildcard, or a directly-internet-facing bind all fail startup.
TNA_ENV=development

# --- Tenant / network ---
TNA_TENANT_ID=tenant_default
TNA_HOST=127.0.0.1
TNA_PORT=4618
# true only when a trusted reverse proxy (see compose.production.yaml) is the sole peer that can reach
# this process — never true on a directly internet-facing listener.
TNA_TRUST_PROXY=false
# Leave unset / empty for no CORS header at all (the restrictive default). Never "*" in production.
TNA_CORS_ALLOW_ORIGIN=

# --- Storage ---
TNA_DATA_DIR=./data

# --- Resource limits (all in milliseconds / bytes) ---
TNA_REQUEST_TIMEOUT_MS=30000
TNA_HEADERS_TIMEOUT_MS=10000
TNA_MAX_BODY_BYTES=262144

# --- Secrets: bearer credentials for the operator/admin/service roles ---
# Each may be supplied directly as an environment value (development/test convenience) or, preferably
# in any real deployment, as a file — set "<NAME>_FILE" to a path instead and TNA reads the file's
# trimmed contents. Every production value must be >= 32 characters, not a known-weak default
# (changeme/admin/secret/password/...), and distinct from the other two.
TNA_OPERATOR_TOKEN=
TNA_ADMIN_TOKEN=
TNA_SERVICE_TOKEN=
# TNA_OPERATOR_TOKEN_FILE=/run/secrets/tna_operator_token
# TNA_ADMIN_TOKEN_FILE=/run/secrets/tna_admin_token
# TNA_SERVICE_TOKEN_FILE=/run/secrets/tna_service_token

# --- Secrets: capability signing key ---
# Required in production (no random in-memory fallback there); optional in development/test.
# TNA_CAPABILITY_KEY=
# TNA_CAPABILITY_KEY_FILE=/run/secrets/tna_capability_key

# --- Section 3/18: v0.1 has no external customer IAM. A single static demo-style agent credential is
# the only agent identity this milestone supports — a real multi-agent identity provider is a future
# milestone's concern (see docs/deployment/deployment-secrets-v0.1.md). ---
# TNA_PLATFORM_DEMO_AGENT_TOKEN=
# TNA_PLATFORM_DEMO_AGENT_ID=
